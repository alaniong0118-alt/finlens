{
  "name": "finlens-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "node --test tests/*.test.mjs",
    "test:qa01": "node --test tests/qa01-*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list --reporter=list",
    "test:e2e:report": "playwright show-report",
    "test:e2e:isolation": "node scripts/e2e-server.mjs --check-isolation"
  },
  "dependencies": {
    "next": "^15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.15.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "autoprefixer": "10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "jsdom": "26.1.0",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  }
}
